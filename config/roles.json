{
  "$comment": "Role-based views. 'lenses' limits which pages the role can see, 'defaultLens' is where the role lands, and 'hideMetrics' removes metric sections for that role without touching the lens definition. showSwitcher is false: the build ships as a single role, with every page visible. Set it true to put the picker back in the page header.",
  "showSwitcher": false,
  "defaultRole": "all",
  "roles": [
    {
      "id": "all",
      "label": "All views",
      "defaultLens": "vendorPerformance",
      "lenses": [
        "vendorPerformance",
        "deliveryPerformance",
        "capacityUtilizationHealth",
        "costEfficiency"
      ],
      "hideMetrics": []
    },
    {
      "id": "vendor-manager",
      "label": "Vendor Manager",
      "defaultLens": "vendorPerformance",
      "lenses": [
        "vendorPerformance"
      ],
      "hideMetrics": []
    },
    {
      "id": "delivery-manager",
      "label": "Delivery Manager",
      "defaultLens": "capacityUtilizationHealth",
      "lenses": [
        "capacityUtilizationHealth",
        "deliveryPerformance",
        "vendorPerformance"
      ],
      "hideMetrics": [
        "headcountByRole"
      ]
    },
    {
      "id": "finance-manager",
      "label": "Finance Manager",
      "defaultLens": "costEfficiency",
      "lenses": [
        "costEfficiency",
        "vendorPerformance"
      ],
      "hideMetrics": [
        "headcountByRole",
        "riskStatus"
      ]
    }
  ]
}
